# ==========================================
# Dependencias (Crucial para monorepos pnpm)
# ==========================================
node_modules/
.pnpm-store/
packages/*/node_modules/

# ==========================================
# Compiled Output (Backend & Frontend)
# ==========================================
dist/
build/
packages/*/dist/
packages/*/build/
# Frameworks de frontend comunes (por si acaso)
.next/
.nuxt/
.svelte-kit/
.vite/

# ==========================================
# Logs
# ==========================================
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ==========================================
# OS / System Files
# ==========================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ==========================================
# Tests & Coverage
# ==========================================
coverage/
.nyc_output/
*.lcov

# ==========================================
# IDEs and Editors
# ==========================================
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.code-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ==========================================
# Environment Variables (¡Nunca subir estos!)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
packages/backend/.env
packages/backend/.env.*

# ==========================================
# Temp & Runtime Data
# ==========================================
.temp/
.tmp/
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ==========================================
# Prisma (Adaptado a estructura de paquetes)
# ==========================================
# El archivo schema.prisma SÍ debe subirse, pero el cliente generado NO.
**/generated/prisma/
node_modules/.prisma/